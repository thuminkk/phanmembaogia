# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật. File .env KHÔNG đưa lên GitHub.

# Link kết nối Neon (Neon Console -> Connect). Bỏ trống = dùng SQLite cục bộ "03. Dữ liệu/app.db".
DATABASE_URL=

# Khóa ký cookie đăng nhập — chuỗi ngẫu nhiên dài, giữ bí mật.
SECRET_KEY=

# Tài khoản quản trị đầu tiên — chỉ dùng khi CSDL chưa có tài khoản nào.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
